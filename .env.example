# Copy this file to .env and fill in real values:   cp .env.example .env
# .env is listed in .gitignore, so your real secrets never get committed.

# Any long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# True while developing on your own computer. Must be False on a live server.
DJANGO_DEBUG=True

# Comma-separated hostnames the site may be served from
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
